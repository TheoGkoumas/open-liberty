################################################################################
# Pre-augmented Keycloak image for Open Liberty MCP FAT tests
#
# Runs `kc.sh build` at image-build time so that the expensive Quarkus
# augmentation (class-path scanning, Hibernate schema migration, provider
# registry construction) is performed once here rather than on every container
# start in CI.
#
# Note: `--optimized` is only accepted by `kc.sh start` (production mode).
# FAT tests use `start-dev` which does not support that flag but still benefits
# from the pre-built augmentation artefacts already present in the image.
#
# Build:
#   podman build -f Containerfile -t icr.io/appcafe/open-liberty/dependencies/keycloak-mcp-fat:26.6.2 .
#
# Sanity-test run:
#   podman run --rm -p 8080:8080 -p 8443:8443 \
#     -e KC_BOOTSTRAP_ADMIN_USERNAME=admin \
#     -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin \
#     icr.io/appcafe/open-liberty/dependencies/keycloak-mcp-fat:26.6.2 \
#     start-dev \
#       --https-key-store-file=/keystore.p12 \
#       --https-key-store-password=password \
#       --hostname-strict=false
################################################################################

# ── Stage 1: run kc.sh build to pre-augment Keycloak ──────────────────────────
FROM quay.io/keycloak/keycloak:26.6.2 AS builder

# Mirror exactly the feature flags used at test runtime so that the augmented
# artefacts match the runtime configuration.
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

# Use the embedded H2 dev-file store — no external database is needed in FAT
# tests and this keeps the image self-contained.
ENV KC_DB=dev-file

WORKDIR /opt/keycloak

# A placeholder keystore is required for kc.sh build to succeed when HTTPS
# options are present.  The real per-test keystore is injected at container
# start time by KeycloakContainer.buildKeycloakKeystore().
RUN keytool -genkeypair \
      -storepass password \
      -storetype PKCS12 \
      -keyalg RSA \
      -keysize 2048 \
      -dname "CN=placeholder" \
      -alias server \
      -ext "SAN:c=DNS:localhost,IP:127.0.0.1" \
      -keystore conf/server.keystore

# ← This is the expensive Quarkus augmentation step moved to build time.
RUN /opt/keycloak/bin/kc.sh build

# ── Stage 2: lean runtime image containing only pre-augmented artefacts ────────
FROM quay.io/keycloak/keycloak:26.6.2

COPY --from=builder /opt/keycloak/ /opt/keycloak/

ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
ENV KC_DB=dev-file

LABEL org.opencontainers.image.source="https://github.com/OpenLiberty/open-liberty"
LABEL org.opencontainers.image.description="Pre-augmented Keycloak image for Open Liberty FAT tests"
LABEL org.opencontainers.image.version="26.6.2"

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
